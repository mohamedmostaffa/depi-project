# BrandMind Environment Variables. Copy this file to .env and fill in your key.
# NEVER commit the real .env file.  (.env is now loaded automatically by src/llm/client.py)

# ---- Google Gemini 2.5 Flash (only response-generation provider) ------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=./chroma_db
# Keep in sync with config/settings.yaml (retrieval.similarity_threshold)
SIMILARITY_THRESHOLD=0.30
TOP_K=4

API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
# Comma-separated trusted frontend origins. Keep these aligned with CORS.
BRANDMIND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Guest support sessions last 30 days by default. SameSite=None is only needed
# when the production portal and API are on different sites; it also requires HTTPS.
BRANDMIND_CUSTOMER_SESSION_TTL_DAYS=30
BRANDMIND_CUSTOMER_COOKIE_SAMESITE=lax
BRANDMIND_CUSTOMER_IGNORED_TTL_HOURS=48
# Admin bearer token (required in production; separate from customer sessions).
BRANDMIND_ADMIN_TOKEN=
BRANDMIND_ADMIN_EMAIL=
BRANDMIND_ADMIN_PASSWORD=
